---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import DepartamentoCard from './DepartamentoCard.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/departamentos/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const imageMap: Record<string, ImageMetadata> = {};
for (const [filePath, mod] of Object.entries(imageModules)) {
  const filename = filePath.split('/').pop();
  if (!filename) continue;
  imageMap[`/images/departamentos/${filename}`] = mod.default;
}

const departamentos = (await getCollection('departamentos')).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<section id="departamentos" class="departamentos" aria-labelledby="departamentos-title">
  <div class="departamentos__inner">
    <header class="departamentos__header">
      <p class="eyebrow">Ministérios</p>
      <h2 id="departamentos-title" class="section-heading">Departamentos Regionais</h2>
    </header>

    <ul class="departamentos__grid">
      {
        departamentos.map((departamento) => {
          const imagem = imageMap[departamento.data.imagem];
          if (!imagem) return null;

          return (
            <li>
              <DepartamentoCard departamento={departamento} imagem={imagem} />
            </li>
          );
        })
      }
    </ul>

    <div class="departamentos__cta-wrap">
      <a href="/obpc-mogi-das-cruzes-departamentos-regionais/" class="departamentos__cta">
        Departamentos
      </a>
    </div>
  </div>
</section>

<style>
  .departamentos {
    scroll-margin-top: 4.5rem;
    padding: var(--space-2xl) var(--space-md);
    background: var(--color-surface);
  }

  .departamentos__inner {
    max-width: 72rem;
    margin-inline: auto;
  }

  .departamentos__header {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .departamentos__header :global(.section-heading) {
    margin-inline: auto;
  }

  .departamentos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .departamentos__grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-md);
    }
  }

  @media (min-width: 1024px) {
    .departamentos__grid {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    }
  }

  .departamentos__cta-wrap {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .departamentos__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-neutral-0);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .departamentos__cta:hover,
  .departamentos__cta:focus-visible {
    background: var(--color-primary-dark);
  }
</style>
