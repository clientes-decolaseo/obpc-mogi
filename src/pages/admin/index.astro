---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';

const session = getSession(Astro.cookies);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — OBPC Mogi</title>
  </head>
  <body class="admin-body">
    {
      !session ? (
        <main class="admin-shell">
          <h1 class="admin-title">Painel administrativo</h1>
          <p class="admin-muted">Entre com suas credenciais para gerenciar comunicados e a galeria.</p>
          <form id="login-form" class="admin-card">
            <label class="admin-label">
              E-mail
              <input type="email" name="email" required autocomplete="username" class="admin-input" />
            </label>
            <label class="admin-label">
              Senha
              <input type="password" name="password" required autocomplete="current-password" class="admin-input" />
            </label>
            <p id="login-error" class="admin-error" hidden></p>
            <button type="submit" class="btn-pill btn-pill--primary">Entrar</button>
          </form>
        </main>
      ) : (
        <main class="admin-shell admin-shell--wide">
          <header class="admin-header">
            <div>
              <p class="eyebrow">Área restrita</p>
              <h1 class="admin-title">Painel administrativo</h1>
              <p class="admin-muted">Logado como {session.email}</p>
            </div>
            <button type="button" id="logout-btn" class="btn-pill btn-pill--primary">Sair</button>
          </header>

          <section class="admin-card">
            <h2 class="admin-subtitle">Novo comunicado</h2>
            <form id="create-form" class="admin-form">
              <label class="admin-label">
                Título
                <input type="text" name="titulo" required class="admin-input" placeholder="Ex: Programação de Agosto" />
              </label>
              <label class="admin-label">
                Data de publicação
                <input type="date" name="dataPublicacao" required class="admin-input" />
              </label>
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <p id="create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary">Publicar</button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Comunicados atuais</h2>
            <p id="list-loading" class="admin-muted">Carregando…</p>
            <p id="list-empty" class="admin-muted" hidden>Nenhum comunicado cadastrado.</p>
            <p id="list-error" class="admin-error" hidden></p>
            <ul id="comunicados-list" class="admin-grid" hidden></ul>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Galeria de Fotos</h2>
            <form id="galeria-create-form" class="admin-form">
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <label class="admin-label">
                Legenda (acessibilidade)
                <input
                  type="text"
                  name="legenda"
                  class="admin-input"
                  placeholder="Ex: Congresso Regional 2026"
                />
              </label>
              <p id="galeria-create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary" id="galeria-create-btn">
                Adicionar à galeria
              </button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Fotos atuais</h2>
            <p id="galeria-list-loading" class="admin-muted">Carregando…</p>
            <p id="galeria-list-empty" class="admin-muted" hidden>Nenhuma foto cadastrada.</p>
            <p id="galeria-list-error" class="admin-error" hidden></p>
            <ul id="galeria-list" class="admin-grid" hidden></ul>
          </section>

          <dialog id="edit-dialog" class="admin-dialog">
            <form id="edit-form" method="dialog" class="admin-form">
              <h2 class="admin-subtitle">Editar comunicado</h2>
              <input type="hidden" name="slug" />
              <label class="admin-label">
                Título
                <input type="text" name="titulo" required class="admin-input" />
              </label>
              <label class="admin-label">
                Data de publicação
                <input type="date" name="dataPublicacao" required class="admin-input" />
              </label>
              <label class="admin-label">
                Nova imagem (opcional)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="admin-input"
                />
              </label>
              <p id="edit-feedback" class="admin-feedback" hidden></p>
              <div class="admin-dialog__actions">
                <button type="button" id="edit-cancel" class="admin-btn-ghost">Cancelar</button>
                <button type="submit" class="btn-pill btn-pill--primary">Salvar</button>
              </div>
            </form>
          </dialog>
        </main>
      )
    }

    <script is:inline>
      const loginForm = document.getElementById('login-form');
      if (loginForm) {
        loginForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget;
          const data = new FormData(form);
          const errorEl = document.getElementById('login-error');
          if (errorEl) {
            errorEl.hidden = true;
            errorEl.textContent = '';
          }

          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: String(data.get('email') || ''),
              password: String(data.get('password') || ''),
            }),
          });

          if (!res.ok) {
            const payload = await res.json().catch(function () {
              return { error: 'Falha no login' };
            });
            if (errorEl) {
              errorEl.hidden = false;
              errorEl.textContent = payload.error || 'Credenciais inválidas';
            }
            return;
          }

          window.location.reload();
        });
      }

      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async function () {
          await fetch('/api/admin/logout', { method: 'POST' });
          window.location.reload();
        });
      }

      function formatDatePt(iso) {
        const parts = String(iso).slice(0, 10).split('-');
        if (parts.length !== 3) return iso;
        const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
        return d.toLocaleDateString('pt-BR');
      }

      function previewUrl(slug) {
        return '/api/admin/comunicados/preview?slug=' + encodeURIComponent(slug);
      }

      async function loadList() {
        const loading = document.getElementById('list-loading');
        const empty = document.getElementById('list-empty');
        const errorEl = document.getElementById('list-error');
        const list = document.getElementById('comunicados-list');
        if (!list) return;

        if (loading) loading.hidden = false;
        if (empty) empty.hidden = true;
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
        list.hidden = true;
        list.innerHTML = '';

        try {
          const res = await fetch('/api/admin/comunicados/list');
          const payload = await res.json();
          if (!res.ok) throw new Error(payload.error || 'Falha ao carregar');

          const items = payload.items || [];
          if (loading) loading.hidden = true;

          if (items.length === 0) {
            if (empty) empty.hidden = false;
            return;
          }

          list.hidden = false;
          items.forEach(function (item) {
            const li = document.createElement('li');
            li.className = 'admin-item';
            li.dataset.slug = item.slug;
            li.dataset.titulo = item.titulo;
            li.dataset.data = item.dataPublicacao;

            li.innerHTML =
              '<img class="admin-item__thumb" width="120" height="120" alt="" src="' +
              previewUrl(item.slug) +
              '" />' +
              '<div class="admin-item__body">' +
              '<strong class="admin-item__title"></strong>' +
              '<span class="admin-item__date"></span>' +
              '<div class="admin-item__actions">' +
              '<button type="button" class="admin-btn-ghost js-edit">Editar</button>' +
              '<button type="button" class="admin-btn-danger js-delete">Excluir</button>' +
              '</div></div>';

            li.querySelector('.admin-item__title').textContent = item.titulo;
            li.querySelector('.admin-item__date').textContent = formatDatePt(item.dataPublicacao);
            list.appendChild(li);
          });
        } catch (err) {
          if (loading) loading.hidden = true;
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = err.message || 'Erro ao carregar lista';
          }
        }
      }

      const createForm = document.getElementById('create-form');
      if (createForm) {
        createForm.addEventListener('submit', async function (event) {
          event.preventDefault();
          const form = event.currentTarget;
          const feedback = document.getElementById('create-feedback');
          const formData = new FormData(form);
          const imagem = formData.get('imagem');
          if (imagem instanceof File && imagem.size > 4 * 1024 * 1024) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.textContent = 'Imagem deve ter no máximo 4MB.';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = '';
            feedback.classList.remove('is-error', 'is-ok');
          }

          const res = await fetch('/api/admin/comunicados/create', {
            method: 'POST',
            body: formData,
          });
          const raw = await res.text();
          let payload = { error: '' };
          try {
            payload = JSON.parse(raw);
          } catch {
            const plain = raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
            payload = {
              error:
                res.status === 413
                  ? 'Imagem grande demais para o servidor (máx. 4MB).'
                  : 'Erro ' + res.status + (plain ? ': ' + plain.slice(0, 180) : ''),
            };
          }

          if (!res.ok) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.textContent = payload.error || 'Não foi possível publicar';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-ok');
            feedback.textContent = 'Publicado. O site atualiza em 1–2 minutos (novo deploy).';
          }
          form.reset();
          loadList();
        });
      }

      const editDialog = document.getElementById('edit-dialog');
      const editForm = document.getElementById('edit-form');
      const editCancel = document.getElementById('edit-cancel');

      editCancel?.addEventListener('click', function () {
        editDialog?.close();
      });

      document.getElementById('comunicados-list')?.addEventListener('click', async function (event) {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const item = target.closest('.admin-item');
        if (!item) return;
        const slug = item.dataset.slug;
        const titulo = item.dataset.titulo;
        const data = item.dataset.data;

        if (target.classList.contains('js-edit')) {
          if (!editForm || !editDialog) return;
          editForm.slug.value = slug;
          editForm.titulo.value = titulo;
          editForm.dataPublicacao.value = String(data).slice(0, 10);
          editForm.imagem.value = '';
          const feedback = document.getElementById('edit-feedback');
          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = '';
            feedback.classList.remove('is-error', 'is-ok');
          }
          editDialog.showModal();
          return;
        }

        if (target.classList.contains('js-delete')) {
          const ok = window.confirm('Excluir o comunicado "' + titulo + '"? Esta ação não pode ser desfeita.');
          if (!ok) return;

          const res = await fetch('/api/admin/comunicados/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: slug }),
          });
          const payload = await res.json().catch(function () {
            return { error: 'Erro ao excluir' };
          });
          if (!res.ok) {
            window.alert(payload.error || 'Não foi possível excluir');
            return;
          }
          loadList();
        }
      });

      editForm?.addEventListener('submit', async function (event) {
        event.preventDefault();
        const form = event.currentTarget;
        const feedback = document.getElementById('edit-feedback');
        const formData = new FormData(form);
        const file = formData.get('imagem');
        if (!(file instanceof File) || file.size === 0) {
          formData.delete('imagem');
        }

        if (feedback) {
          feedback.hidden = true;
          feedback.textContent = '';
          feedback.classList.remove('is-error', 'is-ok');
        }

        const res = await fetch('/api/admin/comunicados/update', {
          method: 'PUT',
          body: formData,
        });
        const payload = await res.json().catch(function () {
          return { error: 'Erro ao salvar' };
        });

        if (!res.ok) {
          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-error');
            feedback.textContent = payload.error || 'Não foi possível salvar';
          }
          return;
        }

        editDialog?.close();
        loadList();
      });

      if (document.getElementById('comunicados-list')) {
        loadList();
      }

      function galeriaPreviewUrl(nome) {
        return '/api/admin/galeria/preview?nome=' + encodeURIComponent(nome);
      }

      async function parseApiJson(res) {
        const raw = await res.text();
        try {
          return JSON.parse(raw);
        } catch {
          const plain = raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
          return {
            error:
              res.status === 413
                ? 'Imagem grande demais para o servidor (máx. 4MB).'
                : 'Erro ' + res.status + (plain ? ': ' + plain.slice(0, 180) : ''),
          };
        }
      }

      async function loadGaleriaList() {
        const loading = document.getElementById('galeria-list-loading');
        const empty = document.getElementById('galeria-list-empty');
        const errorEl = document.getElementById('galeria-list-error');
        const list = document.getElementById('galeria-list');
        if (!list) return;

        if (loading) loading.hidden = false;
        if (empty) empty.hidden = true;
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
        list.hidden = true;
        list.innerHTML = '';

        try {
          const res = await fetch('/api/admin/galeria/list');
          const payload = await parseApiJson(res);
          if (!res.ok) throw new Error(payload.error || 'Falha ao carregar');

          const items = payload.items || [];
          if (loading) loading.hidden = true;

          if (items.length === 0) {
            if (empty) empty.hidden = false;
            return;
          }

          list.hidden = false;
          items.forEach(function (item) {
            const li = document.createElement('li');
            li.className = 'admin-item';
            li.dataset.nome = item.nomeArquivo;

            li.innerHTML =
              '<img class="admin-item__thumb" width="120" height="120" alt="" src="' +
              galeriaPreviewUrl(item.nomeArquivo) +
              '" />' +
              '<div class="admin-item__body">' +
              '<strong class="admin-item__title"></strong>' +
              '<span class="admin-item__date js-legenda"></span>' +
              '<div class="admin-item__actions">' +
              '<button type="button" class="admin-btn-danger js-galeria-delete">Excluir</button>' +
              '</div></div>';

            li.querySelector('.admin-item__title').textContent = item.nomeArquivo;
            const captionEl = li.querySelector('.js-legenda');
            if (item.legenda) {
              captionEl.textContent = item.legenda;
            } else {
              captionEl.textContent = 'Sem legenda';
              captionEl.classList.add('admin-item__caption--empty');
            }
            list.appendChild(li);
          });
        } catch (err) {
          if (loading) loading.hidden = true;
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = err.message || 'Erro ao carregar galeria';
          }
        }
      }

      const galeriaCreateForm = document.getElementById('galeria-create-form');
      if (galeriaCreateForm) {
        galeriaCreateForm.addEventListener('submit', async function (event) {
          event.preventDefault();
          const form = event.currentTarget;
          const feedback = document.getElementById('galeria-create-feedback');
          const submitBtn = document.getElementById('galeria-create-btn');
          const formData = new FormData(form);
          const imagem = formData.get('imagem');
          if (imagem instanceof File && imagem.size > 4 * 1024 * 1024) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.classList.remove('is-ok');
              feedback.textContent = 'Imagem deve ter no máximo 4MB.';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = '';
            feedback.classList.remove('is-error', 'is-ok');
          }
          if (submitBtn) submitBtn.disabled = true;

          const res = await fetch('/api/admin/galeria/create', {
            method: 'POST',
            body: formData,
          });
          const payload = await parseApiJson(res);
          if (submitBtn) submitBtn.disabled = false;

          if (!res.ok) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.textContent = payload.error || 'Não foi possível adicionar a foto';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-ok');
            feedback.textContent = 'Foto adicionada. O site atualiza em 1–2 minutos (novo deploy).';
          }
          form.reset();
          loadGaleriaList();
        });
      }

      document.getElementById('galeria-list')?.addEventListener('click', async function (event) {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !target.classList.contains('js-galeria-delete')) return;
        const item = target.closest('.admin-item');
        if (!item) return;
        const nome = item.dataset.nome;
        const ok = window.confirm('Excluir a foto "' + nome + '"? Esta ação não pode ser desfeita.');
        if (!ok) return;

        const res = await fetch('/api/admin/galeria/delete', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nomeArquivo: nome }),
        });
        const payload = await parseApiJson(res);
        if (!res.ok) {
          window.alert(payload.error || 'Não foi possível excluir');
          return;
        }
        loadGaleriaList();
      });

      if (document.getElementById('galeria-list')) {
        loadGaleriaList();
      }
    </script>

    <style>
      .admin-body {
        margin: 0;
        min-height: 100vh;
        font-family: var(--font-body);
        color: var(--color-neutral-900);
        background: var(--color-surface);
      }

      .admin-shell {
        max-width: 40rem;
        margin: 0 auto;
        padding: var(--space-2xl) var(--space-md);
      }

      .admin-shell--wide {
        max-width: 56rem;
      }

      .admin-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-md);
        margin-bottom: var(--space-xl);
      }

      .admin-title {
        margin: 0 0 var(--space-xs);
        font-size: var(--text-h2);
        font-weight: var(--weight-display);
        letter-spacing: var(--tracking-tight);
        color: var(--color-primary-dark);
      }

      .admin-subtitle {
        margin: 0 0 var(--space-md);
        font-size: var(--text-h3);
        color: var(--color-primary);
      }

      .admin-muted {
        margin: 0 0 var(--space-lg);
        color: var(--color-neutral-700);
      }

      .admin-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
        padding: var(--space-lg);
        background: var(--color-neutral-0);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
      }

      .admin-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
      }

      .admin-label {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        font-weight: var(--weight-medium);
        font-size: 0.9375rem;
      }

      .admin-input {
        padding: 0.75rem 0.875rem;
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-md);
        font: inherit;
      }

      .admin-error {
        margin: 0;
        color: #b42318;
        font-size: 0.9375rem;
      }

      .admin-feedback {
        margin: 0;
        font-size: 0.9375rem;
      }

      .admin-feedback.is-ok {
        color: var(--color-secondary);
      }

      .admin-feedback.is-error {
        color: #b42318;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      @media (min-width: 640px) {
        .admin-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .admin-item {
        display: flex;
        gap: var(--space-md);
        padding: var(--space-md);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-lg);
        background: var(--color-neutral-0);
      }

      .admin-item__thumb {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: var(--radius-md);
        flex-shrink: 0;
        background: var(--color-neutral-100);
      }

      .admin-item__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
      }

      .admin-item__title {
        color: var(--color-primary-dark);
        font-size: 1rem;
      }

      .admin-item__date {
        color: var(--color-neutral-700);
        font-size: 0.875rem;
      }

      .admin-item__caption--empty {
        font-style: italic;
        color: var(--color-neutral-500);
      }

      .admin-item__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        margin-top: auto;
      }

      .admin-btn-ghost,
      .admin-btn-danger {
        padding: 0.4rem 0.75rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-neutral-200);
        background: transparent;
        font: inherit;
        font-size: 0.875rem;
        font-weight: var(--weight-medium);
        cursor: pointer;
      }

      .admin-btn-ghost {
        color: var(--color-primary);
      }

      .admin-btn-danger {
        color: #b42318;
        border-color: #f3c1bc;
      }

      .admin-dialog {
        width: min(28rem, calc(100vw - 2rem));
        border: 0;
        border-radius: var(--radius-lg);
        padding: var(--space-lg);
        box-shadow: var(--shadow-md);
      }

      .admin-dialog::backdrop {
        background: rgb(15 38 71 / 0.55);
      }

      .admin-dialog__actions {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-sm);
      }

      .btn-pill {
        align-self: flex-start;
        border: 0;
        cursor: pointer;
      }
    </style>
  </body>
</html>
