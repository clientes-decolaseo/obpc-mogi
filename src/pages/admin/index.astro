      function applyIgrejaFilter() {
        const input = document.getElementById('igreja-search');
        const list = document.getElementById('igreja-list');
        const noMatch = document.getElementById('igreja-list-nomatch');
        if (!input || !list) return;
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        list.querySelectorAll('.admin-item').forEach(function (li) {
          const nome = (li.dataset.nome || '').toLowerCase();
          const show = !q || nome.indexOf(q) !== -1;
          li.hidden = !show;
          if (show) visible += 1;
        });
        if (noMatch) {
          noMatch.hidden = list.hidden || visible > 0 || list.children.length === 0;
        }
      }

