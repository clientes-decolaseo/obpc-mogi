          top: 0;
          height: auto;
          z-index: 20;
          padding: var(--space-md);
        }

        .admin-sidebar__nav {
          flex-direction: row;
          overflow-x: auto;
          margin: var(--space-md) 0;
          flex: 0 0 auto;
          -webkit-overflow-scrolling: touch;
        }

        .admin-nav-item {
          white-space: nowrap;
          flex-shrink: 0;
        }

        .admin-sidebar__logout {
          align-self: flex-start;
        }

        .admin-content {
          padding: var(--space-lg) var(--space-md);
          overflow-y: visible;
        }
      }

      .admin-optional {
        font-weight: var(--weight-regular);
        color: var(--color-neutral-700);
        font-size: 0.8125rem;
      }

      .admin-title {
        margin: 0 0 var(--space-xs);
        font-size: var(--text-h2);
        font-weight: var(--weight-display);
        letter-spacing: var(--tracking-tight);
        color: var(--color-primary-dark);
      }

      .admin-subtitle {
        margin: 0 0 var(--space-md);
        font-size: var(--text-h3);
        color: var(--color-primary);
      }

      .admin-muted {
        margin: 0 0 var(--space-lg);
        color: var(--color-neutral-700);
      }

      .admin-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
        padding: var(--space-lg);
        background: var(--color-neutral-0);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
      }

      .admin-form {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
      }

      .admin-label {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        font-weight: var(--weight-medium);
        font-size: 0.9375rem;
      }

      .admin-input {
        padding: 0.75rem 0.875rem;
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-md);
        font: inherit;
      }

      .admin-textarea {
        min-height: 8rem;
        resize: vertical;
        line-height: 1.5;
      }

      .admin-error {
        margin: 0;
        color: #b42318;
        font-size: 0.9375rem;
      }

      .admin-feedback {
        margin: 0;
        font-size: 0.9375rem;
      }

      .admin-feedback.is-ok {
        color: var(--color-secondary);
      }

      .admin-feedback.is-error {
        color: #b42318;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-md);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      @media (min-width: 640px) {
        .admin-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .admin-item {
        display: flex;
        gap: var(--space-md);
        padding: var(--space-md);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-lg);
        background: var(--color-neutral-0);
      }

      .admin-item__thumb {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: var(--radius-md);
        flex-shrink: 0;
        background: var(--color-neutral-100);
      }

      .admin-item__body {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
        min-width: 0;
      }

      .admin-item__title {
        color: var(--color-primary-dark);
        font-size: 1rem;
      }

      .admin-item__date {
        color: var(--color-neutral-700);
        font-size: 0.875rem;
      }

      .admin-item__caption--empty {
        font-style: italic;
        color: var(--color-neutral-500);
      }

      .admin-item__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
        margin-top: auto;
      }

      .admin-btn-ghost,
      .admin-btn-danger {
        padding: 0.4rem 0.75rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-neutral-200);
        background: transparent;
        font: inherit;
        font-size: 0.875rem;
        font-weight: var(--weight-medium);
        cursor: pointer;
      }

      .admin-btn-ghost {
        color: var(--color-primary);
      }

      .admin-btn-danger {
        color: #b42318;
        border-color: #f3c1bc;
      }

      .admin-dialog {
        width: min(28rem, calc(100vw - 2rem));
        border: 0;
        border-radius: var(--radius-lg);
        padding: var(--space-lg);
        box-shadow: var(--shadow-md);
      }

      .admin-dialog--wide {
        width: min(40rem, calc(100vw - 2rem));
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
      }

      .admin-dialog__preview {
        width: 100%;
        max-height: 10rem;
        object-fit: contain;
        border-radius: var(--radius-md);
        background: var(--color-neutral-100);
      }

      .admin-dialog::backdrop {
        background: rgb(15 38 71 / 0.55);
      }

      .admin-dialog__actions {
        display: flex;
        justify-content: flex-end;
        gap: var(--space-sm);
      }

      .btn-pill {
        align-self: flex-start;
        border: 0;
        cursor: pointer;
      }
    </style>
  </body>
</html>
