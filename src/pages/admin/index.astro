---
export const prerender = false;

import '../../styles/global.css';
import { getSession } from '../../lib/auth';

const session = getSession(Astro.cookies);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — OBPC Mogi</title>
  </head>
  <body class="admin-body">
    {
      !session ? (
        <main class="admin-shell">
          <h1 class="admin-title">Painel administrativo</h1>
          <p class="admin-muted">Entre com suas credenciais para gerenciar comunicados, galeria, departamentos e igrejas.</p>
          <form id="login-form" class="admin-card">
            <label class="admin-label">
              E-mail
              <input type="email" name="email" required autocomplete="username" class="admin-input" />
            </label>
            <label class="admin-label">
              Senha
              <input type="password" name="password" required autocomplete="current-password" class="admin-input" />
            </label>
            <p id="login-error" class="admin-error" hidden></p>
            <button type="submit" class="btn-pill btn-pill--primary">Entrar</button>
          </form>
        </main>
      ) : (
        <div class="admin-layout">
          <aside class="admin-sidebar">
            <div class="admin-sidebar__header">
              <p class="admin-sidebar__brand">Painel OBPC</p>
              <p class="admin-sidebar__user">{session.email}</p>
            </div>
            <nav class="admin-sidebar__nav" aria-label="Seções do painel">
              <button type="button" class="admin-nav-item is-active" data-section="comunicados" aria-current="page">
                Comunicados
              </button>
              <button type="button" class="admin-nav-item" data-section="galeria">Galeria de Fotos</button>
              <button type="button" class="admin-nav-item" data-section="departamentos">Departamentos</button>
              <button type="button" class="admin-nav-item" data-section="igrejas">Igrejas</button>
            </nav>
            <button type="button" id="logout-btn" class="admin-sidebar__logout">Sair</button>
          </aside>
          <main class="admin-content">
          <section id="section-comunicados" class="admin-section is-active">
          <section class="admin-card">
            <h2 class="admin-subtitle">Novo comunicado</h2>
            <form id="create-form" class="admin-form">
              <label class="admin-label">
                Título
                <input type="text" name="titulo" required class="admin-input" placeholder="Ex: Programação de Agosto" />
              </label>
              <label class="admin-label">
                Data de publicação
                <input type="date" name="dataPublicacao" required class="admin-input" />
              </label>
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <p id="create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary">Publicar</button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Comunicados atuais</h2>
            <p id="list-loading" class="admin-muted">Carregando…</p>
            <p id="list-empty" class="admin-muted" hidden>Nenhum comunicado cadastrado.</p>
            <p id="list-error" class="admin-error" hidden></p>
            <ul id="comunicados-list" class="admin-grid" hidden></ul>
          </section>
          </section>

          <section id="section-galeria" class="admin-section">
          <section class="admin-card">
            <h2 class="admin-subtitle">Galeria de Fotos</h2>
            <form id="galeria-create-form" class="admin-form">
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <label class="admin-label">
                Legenda (acessibilidade)
                <input
                  type="text"
                  name="legenda"
                  class="admin-input"
                  placeholder="Ex: Congresso Regional 2026"
                />
              </label>
              <p id="galeria-create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary" id="galeria-create-btn">
                Adicionar à galeria
              </button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Fotos atuais</h2>
            <p id="galeria-list-loading" class="admin-muted">Carregando…</p>
            <p id="galeria-list-empty" class="admin-muted" hidden>Nenhuma foto cadastrada.</p>
            <p id="galeria-list-error" class="admin-error" hidden></p>
            <ul id="galeria-list" class="admin-grid" hidden></ul>
          </section>
          </section>

          <section id="section-departamentos" class="admin-section">
          <section class="admin-card">
            <h2 class="admin-subtitle">Novo departamento</h2>
            <form id="dept-create-form" class="admin-form">
              <label class="admin-label">
                Nome
                <input type="text" name="nome" required class="admin-input" placeholder="Ex: ADOBRAC" />
              </label>
              <label class="admin-label">
                Sigla
                <input type="text" name="sigla" required class="admin-input" placeholder="Ex: ADOBRAC" />
              </label>
              <label class="admin-label">
                Descrição curta
                <input type="text" name="descricaoCurta" required class="admin-input" />
              </label>
              <label class="admin-label">
                Descrição completa
                <textarea name="descricaoCompleta" required class="admin-input admin-textarea" rows="6"></textarea>
              </label>
              <label class="admin-label">
                Liderança
                <input type="text" name="lideranca" required class="admin-input" />
              </label>
              <label class="admin-label">
                Ordem
                <input type="number" name="ordem" required class="admin-input" min="0" step="1" />
              </label>
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <p id="dept-create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary" id="dept-create-btn">Criar departamento</button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Departamentos Regionais</h2>
            <p id="dept-list-loading" class="admin-muted">Carregando…</p>
            <p id="dept-list-empty" class="admin-muted" hidden>Nenhum departamento cadastrado.</p>
            <p id="dept-list-error" class="admin-error" hidden></p>
            <ul id="dept-list" class="admin-grid" hidden></ul>
          </section>
          </section>

          <section id="section-igrejas" class="admin-section">
          <section class="admin-card">
            <h2 class="admin-subtitle">Nova igreja</h2>
            <form id="igreja-create-form" class="admin-form">
              <label class="admin-label">
                Nome
                <input type="text" name="nome" required class="admin-input" placeholder="Ex: Igreja OBPC – Alto Guaianases" />
              </label>
              <label class="admin-label">
                Dirigente
                <input type="text" name="dirigente" required class="admin-input" />
              </label>
              <label class="admin-label">
                WhatsApp <span class="admin-optional">(opcional)</span>
                <input type="tel" name="telefoneWhatsapp" class="admin-input" placeholder="Ex: 5511916656614" />
              </label>
              <label class="admin-label">
                Facebook <span class="admin-optional">(opcional)</span>
                <input type="url" name="facebook" class="admin-input" placeholder="https://www.facebook.com/..." />
              </label>
              <label class="admin-label">
                E-mail <span class="admin-optional">(opcional)</span>
                <input type="email" name="email" class="admin-input" />
              </label>
              <label class="admin-label">
                Endereço
                <input type="text" name="endereco" required class="admin-input" />
              </label>
              <label class="admin-label">
                CEP <span class="admin-optional">(opcional)</span>
                <input type="text" name="cep" class="admin-input" placeholder="Ex: 08715-210" />
              </label>
              <label class="admin-label">
                URL do mapa
                <input type="url" name="mapaUrl" required class="admin-input" placeholder="https://www.google.com.br/maps/..." />
              </label>
              <label class="admin-label">
                Imagem (jpg, png ou webp — máx. 4MB)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  required
                  class="admin-input"
                />
              </label>
              <p id="igreja-create-feedback" class="admin-feedback" hidden></p>
              <button type="submit" class="btn-pill btn-pill--primary" id="igreja-create-btn">Criar igreja</button>
            </form>
          </section>

          <section class="admin-card">
            <h2 class="admin-subtitle">Igrejas</h2>
            <label class="admin-label">
              Buscar por nome
              <input type="search" id="igreja-search" class="admin-input" placeholder="Ex: Alto Guaianases" autocomplete="off" />
            </label>
            <p id="igreja-list-loading" class="admin-muted">Carregando…</p>
            <p id="igreja-list-empty" class="admin-muted" hidden>Nenhuma igreja cadastrada.</p>
            <p id="igreja-list-nomatch" class="admin-muted" hidden>Nenhuma igreja corresponde à busca.</p>
            <p id="igreja-list-error" class="admin-error" hidden></p>
            <ul id="igreja-list" class="admin-grid" hidden></ul>
          </section>
          </section>
          </main>

          <dialog id="edit-dialog" class="admin-dialog">
            <form id="edit-form" method="dialog" class="admin-form">
              <h2 class="admin-subtitle">Editar comunicado</h2>
              <input type="hidden" name="slug" />
              <label class="admin-label">
                Título
                <input type="text" name="titulo" required class="admin-input" />
              </label>
              <label class="admin-label">
                Data de publicação
                <input type="date" name="dataPublicacao" required class="admin-input" />
              </label>
              <label class="admin-label">
                Nova imagem (opcional)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="admin-input"
                />
              </label>
              <p id="edit-feedback" class="admin-feedback" hidden></p>
              <div class="admin-dialog__actions">
                <button type="button" id="edit-cancel" class="admin-btn-ghost">Cancelar</button>
                <button type="submit" class="btn-pill btn-pill--primary">Salvar</button>
              </div>
            </form>
          </dialog>

          <dialog id="dept-edit-dialog" class="admin-dialog admin-dialog--wide">
            <form id="dept-edit-form" method="dialog" class="admin-form">
              <h2 class="admin-subtitle">Editar departamento</h2>
              <img id="dept-edit-preview" class="admin-dialog__preview" alt="Imagem atual do departamento" width="240" height="240" />
              <input type="hidden" name="slug" />
              <label class="admin-label">
                Nome
                <input type="text" name="nome" required class="admin-input" />
              </label>
              <label class="admin-label">
                Sigla
                <input type="text" name="sigla" required class="admin-input" />
              </label>
              <label class="admin-label">
                Descrição curta
                <input type="text" name="descricaoCurta" required class="admin-input" />
              </label>
              <label class="admin-label">
                Descrição completa
                <textarea name="descricaoCompleta" required class="admin-input admin-textarea" rows="8"></textarea>
              </label>
              <label class="admin-label">
                Liderança
                <input type="text" name="lideranca" required class="admin-input" />
              </label>
              <label class="admin-label">
                Ordem
                <input type="number" name="ordem" required class="admin-input" min="0" step="1" />
              </label>
              <label class="admin-label">
                Trocar imagem (deixe vazio para manter a atual)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="admin-input"
                />
              </label>
              <p id="dept-edit-feedback" class="admin-feedback" hidden></p>
              <div class="admin-dialog__actions">
                <button type="button" id="dept-edit-cancel" class="admin-btn-ghost">Cancelar</button>
                <button type="submit" class="btn-pill btn-pill--primary">Salvar</button>
              </div>
            </form>
          </dialog>

          <dialog id="igreja-edit-dialog" class="admin-dialog admin-dialog--wide">
            <form id="igreja-edit-form" method="dialog" class="admin-form">
              <h2 class="admin-subtitle">Editar igreja</h2>
              <img id="igreja-edit-preview" class="admin-dialog__preview" alt="Imagem atual da igreja" width="240" height="240" />
              <input type="hidden" name="slug" />
              <label class="admin-label">
                Nome
                <input type="text" name="nome" required class="admin-input" />
              </label>
              <label class="admin-label">
                Dirigente
                <input type="text" name="dirigente" required class="admin-input" />
              </label>
              <label class="admin-label">
                WhatsApp <span class="admin-optional">(opcional)</span>
                <input type="tel" name="telefoneWhatsapp" class="admin-input" />
              </label>
              <label class="admin-label">
                Facebook <span class="admin-optional">(opcional)</span>
                <input type="url" name="facebook" class="admin-input" />
              </label>
              <label class="admin-label">
                E-mail <span class="admin-optional">(opcional)</span>
                <input type="email" name="email" class="admin-input" />
              </label>
              <label class="admin-label">
                Endereço
                <input type="text" name="endereco" required class="admin-input" />
              </label>
              <label class="admin-label">
                CEP <span class="admin-optional">(opcional)</span>
                <input type="text" name="cep" class="admin-input" />
              </label>
              <label class="admin-label">
                URL do mapa
                <input type="url" name="mapaUrl" required class="admin-input" />
              </label>
              <label class="admin-label">
                Trocar imagem (deixe vazio para manter a atual)
                <input
                  type="file"
                  name="imagem"
                  accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                  class="admin-input"
                />
              </label>
              <p id="igreja-edit-feedback" class="admin-feedback" hidden></p>
              <div class="admin-dialog__actions">
                <button type="button" id="igreja-edit-cancel" class="admin-btn-ghost">Cancelar</button>
                <button type="submit" class="btn-pill btn-pill--primary">Salvar</button>
              </div>
            </form>
          </dialog>
        </div>
      )
    }

    <script is:inline>
      const loginForm = document.getElementById('login-form');
      if (loginForm) {
        loginForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget;
          const data = new FormData(form);
          const errorEl = document.getElementById('login-error');
          if (errorEl) {
            errorEl.hidden = true;
            errorEl.textContent = '';
          }

          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: String(data.get('email') || ''),
              password: String(data.get('password') || ''),
            }),
          });

          if (!res.ok) {
            const payload = await res.json().catch(function () {
              return { error: 'Falha no login' };
            });
            if (errorEl) {
              errorEl.hidden = false;
              errorEl.textContent = payload.error || 'Credenciais inválidas';
            }
            return;
          }

          window.location.reload();
        });
      }

      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async function () {
          await fetch('/api/admin/logout', { method: 'POST' });
          window.location.reload();
        });
      }

      document.querySelectorAll('.admin-nav-item').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const section = btn.getAttribute('data-section');
          document.querySelectorAll('.admin-nav-item').forEach(function (el) {
            el.classList.remove('is-active');
            el.removeAttribute('aria-current');
          });
          document.querySelectorAll('.admin-section').forEach(function (el) {
            el.classList.remove('is-active');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-current', 'page');
          const panel = document.getElementById('section-' + section);
          if (panel) panel.classList.add('is-active');
        });
      });

      function formatDatePt(iso) {
        const parts = String(iso).slice(0, 10).split('-');
        if (parts.length !== 3) return iso;
        const d = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
        return d.toLocaleDateString('pt-BR');
      }

      function previewUrl(slug) {
        return '/api/admin/comunicados/preview?slug=' + encodeURIComponent(slug);
      }

      async function loadList() {
        const loading = document.getElementById('list-loading');
        const empty = document.getElementById('list-empty');
        const errorEl = document.getElementById('list-error');
        const list = document.getElementById('comunicados-list');
        if (!list) return;

        if (loading) loading.hidden = false;
        if (empty) empty.hidden = true;
        if (errorEl) {
          errorEl.hidden = true;
          errorEl.textContent = '';
        }
        list.hidden = true;
        list.innerHTML = '';

        try {
          const res = await fetch('/api/admin/comunicados/list');
          const payload = await res.json();
          if (!res.ok) throw new Error(payload.error || 'Falha ao carregar');

          const items = payload.items || [];
          if (loading) loading.hidden = true;

          if (items.length === 0) {
            if (empty) empty.hidden = false;
            return;
          }

          list.hidden = false;
          items.forEach(function (item) {
            const li = document.createElement('li');
            li.className = 'admin-item';
            li.dataset.slug = item.slug;
            li.dataset.titulo = item.titulo;
            li.dataset.data = item.dataPublicacao;

            li.innerHTML =
              '<img class="admin-item__thumb" width="120" height="120" alt="" src="' +
              previewUrl(item.slug) +
              '" />' +
              '<div class="admin-item__body">' +
              '<strong class="admin-item__title"></strong>' +
              '<span class="admin-item__date"></span>' +
              '<div class="admin-item__actions">' +
              '<button type="button" class="admin-btn-ghost js-edit">Editar</button>' +
              '<button type="button" class="admin-btn-danger js-delete">Excluir</button>' +
              '</div></div>';

            li.querySelector('.admin-item__title').textContent = item.titulo;
            li.querySelector('.admin-item__date').textContent = formatDatePt(item.dataPublicacao);
            list.appendChild(li);
          });
        } catch (err) {
          if (loading) loading.hidden = true;
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = err.message || 'Erro ao carregar lista';
          }
        }
      }

      const createForm = document.getElementById('create-form');
      if (createForm) {
        createForm.addEventListener('submit', async function (event) {
          event.preventDefault();
          const form = event.currentTarget;
          const feedback = document.getElementById('create-feedback');
          const formData = new FormData(form);
          const imagem = formData.get('imagem');
          if (imagem instanceof File && imagem.size > 4 * 1024 * 1024) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.textContent = 'Imagem deve ter no máximo 4MB.';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = '';
            feedback.classList.remove('is-error', 'is-ok');
          }

          const res = await fetch('/api/admin/comunicados/create', {
            method: 'POST',
            body: formData,
          });
          const raw = await res.text();
          let payload = { error: '' };
          try {
            payload = JSON.parse(raw);
          } catch {
            const plain = raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
            payload = {
              error:
                res.status === 413
                  ? 'Imagem grande demais para o servidor (máx. 4MB).'
                  : 'Erro ' + res.status + (plain ? ': ' + plain.slice(0, 180) : ''),
            };
          }

          if (!res.ok) {
            if (feedback) {
              feedback.hidden = false;
              feedback.classList.add('is-error');
              feedback.textContent = payload.error || 'Não foi possível publicar';
            }
            return;
          }

          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-ok');
            feedback.textContent = 'Publicado. O site atualiza em 1–2 minutos (novo deploy).';
          }
          form.reset();
          loadList();
        });
      }

      const editDialog = document.getElementById('edit-dialog');
      const editForm = document.getElementById('edit-form');
      const editCancel = document.getElementById('edit-cancel');

      editCancel?.addEventListener('click', function () {
        editDialog?.close();
      });

      document.getElementById('comunicados-list')?.addEventListener('click', async function (event) {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const item = target.closest('.admin-item');
        if (!item) return;
        const slug = item.dataset.slug;
        const titulo = item.dataset.titulo;
        const data = item.dataset.data;

        if (target.classList.contains('js-edit')) {
          if (!editForm || !editDialog) return;
          editForm.slug.value = slug;
          editForm.titulo.value = titulo;
          editForm.dataPublicacao.value = String(data).slice(0, 10);
          editForm.imagem.value = '';
          const feedback = document.getElementById('edit-feedback');
          if (feedback) {
            feedback.hidden = true;
            feedback.textContent = '';
            feedback.classList.remove('is-error', 'is-ok');
          }
          editDialog.showModal();
          return;
        }

        if (target.classList.contains('js-delete')) {
          const ok = window.confirm('Excluir o comunicado "' + titulo + '"? Esta ação não pode ser desfeita.');
          if (!ok) return;

          const res = await fetch('/api/admin/comunicados/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug: slug }),
          });
          const payload = await res.json().catch(function () {
            return { error: 'Erro ao excluir' };
          });
          if (!res.ok) {
            window.alert(payload.error || 'Não foi possível excluir');
            return;
          }
          loadList();
        }
      });

      editForm?.addEventListener('submit', async function (event) {
        event.preventDefault();
        const form = event.currentTarget;
        const feedback = document.getElementById('edit-feedback');
        const formData = new FormData(form);
        const file = formData.get('imagem');
        if (!(file instanceof File) || file.size === 0) {
          formData.delete('imagem');
        }

        if (feedback) {
          feedback.hidden = true;
          feedback.textContent = '';
          feedback.classList.remove('is-error', 'is-ok');
        }

        const res = await fetch('/api/admin/comunicados/update', {
          method: 'PUT',
          body: formData,
        });
        const payload = await res.json().catch(function () {
          return { error: 'Erro ao salvar' };
        });

        if (!res.ok) {
          if (feedback) {
            feedback.hidden = false;
            feedback.classList.add('is-error');
            feedback.textContent = payload.error || 'Não foi possível salvar';
          }
          return;
        }

        editDialog?.close();
        loadList();
      });

      if (document.getElementById('comunicados-list')) {
        loadList();
      }

      function galeriaPreviewUrl(nome) {
        return '/api/admin/galeria/preview?nome=' + encodeURIComponent(nome);
